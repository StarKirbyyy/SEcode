# DeepSeek (set the API key only in .env.local)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CONTEXT_WINDOW=1000000

# LongCat or an OpenAI-compatible LongCat gateway
LONGCAT_API_KEY=
LONGCAT_BASE_URL=
LONGCAT_MODEL=
LONGCAT_CONTEXT_WINDOW=64000
LONGCAT_SUPPORTS_THINKING=false

# Optional generic OpenAI-compatible endpoint
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_CONTEXT_WINDOW=64000
OPENAI_COMPAT_SUPPORTS_THINKING=false

# Optional local state directory; defaults to .secode-data
SECODE_DATA_DIR=.secode-data
